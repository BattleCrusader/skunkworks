{
  "$comment": "D21/C-4/C-23: the component vocabulary the image ships. This file is the source; the app upserts it into cms_component_registry inside one transaction at boot, and every row here must satisfy the table's CHECKs (scripts/model/verify_claims.py check 26 loads it and proves that). 'drag-and-drop is guaranteed within this registry' is a statement about this list, not about HTML in general: a component that is not here cannot be dragged, and a page body that names one is refused at publish with SKW_E_RT_TEMPLATE_UNKNOWN (shells) or degraded to an editable div on save (blocks, measured R1 M1/M2).",
  "version": 3,
  "components": [
    {"name": "hero", "kind": "block", "renderer": "components/hero.ts", "version": "1.0.0",
     "bindings": ["title", "subtitle", "asset-image", "href-cta"],
     "props": {"type": "object", "properties": {"align": {"enum": ["left", "center"]}}, "additionalProperties": false}},
    {"name": "prose", "kind": "block", "renderer": "components/prose.ts", "version": "1.0.0",
     "bindings": [], "props": {"type": "object", "properties": {}, "additionalProperties": false}},
    {"name": "image", "kind": "block", "renderer": "components/image.ts", "version": "1.0.0",
     "bindings": ["asset-src", "alt"],
     "props": {"type": "object", "properties": {"ratio": {"enum": ["1:1", "4:3", "16:9"]}}, "additionalProperties": false}},
    {"name": "gallery", "kind": "block", "renderer": "components/gallery.ts", "version": "1.0.0",
     "bindings": ["asset-src"],
     "props": {"type": "object", "properties": {"columns": {"type": "integer", "minimum": 1, "maximum": 6}}, "additionalProperties": false}},
    {"name": "download-button", "kind": "block", "renderer": "components/download-button.ts", "version": "1.0.0",
     "bindings": ["asset-href", "title"],
     "props": {"type": "object", "properties": {"label": {"type": "string", "maxLength": 80}}, "additionalProperties": false}},
    {"name": "cta", "kind": "block", "renderer": "components/cta.ts", "version": "1.0.0",
     "bindings": ["title", "href-target"], "props": {"type": "object", "properties": {}, "additionalProperties": false}},
    {"name": "form", "kind": "block", "renderer": "components/form.ts", "version": "1.0.0",
     "bindings": [], "props": {"type": "object", "properties": {"form": {"type": "string"}}, "required": ["form"], "additionalProperties": false}},
    {"name": "embed", "kind": "block", "renderer": "components/embed.ts", "version": "1.0.0",
     "bindings": [], "props": {"type": "object", "properties": {"src": {"type": "string", "format": "uri"}}, "required": ["src"], "additionalProperties": false}},
    {"name": "list", "kind": "list", "renderer": "components/list.ts", "version": "1.0.0",
     "repeat_child": "[data-repeat]", "limit_max": 50,
     "bindings": ["title", "subtitle", "href-slug", "asset-cover"],
     "props": {"type": "object", "properties": {"source": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "required": ["source"], "additionalProperties": false},
     "loop": "SSR clones the single [data-repeat] child once per row; text goes through data-bind-<col> (a text node, never markup), href through data-bind-href-<col> (via site.url()), src/srcset through data-bind-asset-<col> (via site.asset()); zero rows render the [data-empty] child; data-limit is clamped to limit_max and data-truncated is set when it clamped."},
    {"name": "page", "kind": "shell", "renderer": "components/shell-page.astro", "version": "1.0.0", "bindings": []},
    {"name": "landing", "kind": "shell", "renderer": "components/shell-landing.astro", "version": "1.0.0", "bindings": []},
    {"name": "post", "kind": "shell", "renderer": "components/shell-post.astro", "version": "1.0.0", "bindings": []},
    {"name": "index", "kind": "shell", "renderer": "components/shell-index.astro", "version": "1.0.0", "bindings": []},
    {"name": "copy-email", "kind": "island", "renderer": "islands/copy-email.ts", "version": "1.0.0",
     "bindings": [], "props": {"type": "object", "properties": {"address": {"type": "string", "format": "email"}}, "required": ["address"], "additionalProperties": false}}
  ]
}

{
  "$comment": "D21/C-4/C-23: the component vocabulary the image ships. This file is the source; the app upserts it into cms_component_registry inside one transaction at boot, and every row here must satisfy the table's CHECKs (scripts/model/verify_claims.py check 26 loads it and proves that). 'drag-and-drop is guaranteed within this registry' is a statement about this list, not about HTML in general: a component not here cannot be dragged, and a page body that names one is refused at SAVE with SKW_E_RT_COMPONENT_UNKNOWN (S4a) — GrapesJS would otherwise strip data-gjs-type and degrade the block to an editable div (176 B -> 110 B, measured R2 Runtime M1/M2). v4 adds the editor half of each entry: type (the data-gjs-type, always the name), label+category (the palette), editable (what the settings panel may write), allowed_children (the nesting rule), html (the block the palette inserts, the renderer emits) and css (one rule set per component; cms_page.body_css is their concatenation). One entry is the single source for the palette, the renderer and all three exporters.",
  "version": 4,
  "components": [
    {"name": "hero", "kind": "block", "type": "hero", "label": "Hero", "category": "Structure",
     "renderer": "components/hero.ts", "version": "1.0.0",
     "bindings": ["title", "subtitle", "asset-image", "href-cta"],
     "props": {"type": "object", "properties": {"align": {"enum": ["left", "center"]}}, "additionalProperties": false},
     "editable": [{"prop": "title", "type": "text"}, {"prop": "subtitle", "type": "text"}, {"prop": "image", "type": "asset"}, {"prop": "cta", "type": "href"}],
     "allowed_children": ["prose", "cta"],
     "html": "<section class=\"hero\" data-gjs-type=\"hero\" data-align=\"left\"><div class=\"hero__inner\"><h1 class=\"hero__title\" data-prop=\"title\">A headline that says what this is</h1><p class=\"hero__subtitle\" data-prop=\"subtitle\">One sentence about who it is for.</p><img class=\"hero__image\" data-prop=\"image\" data-asset-key=\"banner/home\" alt=\"\"><a class=\"btn btn--primary\" data-prop=\"cta\" href=\"/contact\">Talk to us</a></div></section>",
     "css": ".hero{padding:4rem 1.5rem}.hero__inner{max-width:56rem;margin:0 auto}.hero__title{font-size:2.5rem;line-height:1.1}.hero__subtitle{font-size:1.125rem;color:var(--muted)}.hero__image{max-width:100%;height:auto}"},

    {"name": "prose", "kind": "block", "type": "prose", "label": "Prose", "category": "Text",
     "renderer": "components/prose.ts", "version": "1.0.0",
     "bindings": [], "props": {"type": "object", "properties": {}, "additionalProperties": false},
     "editable": [{"prop": "body", "type": "text"}],
     "allowed_children": [],
     "html": "<div class=\"prose\" data-gjs-type=\"prose\"><p data-prop=\"body\">Write the paragraph here.</p></div>",
     "css": ".prose{max-width:42rem;margin:0 auto;line-height:1.6}"},

    {"name": "figure", "kind": "block", "type": "figure", "label": "Image", "category": "Media",
     "renderer": "components/figure.ts", "version": "1.0.0",
     "bindings": ["asset-src", "alt"],
     "props": {"type": "object", "properties": {"ratio": {"enum": ["1:1", "4:3", "16:9"]}}, "additionalProperties": false},
     "editable": [{"prop": "src", "type": "asset"}, {"prop": "caption", "type": "text"}],
     "allowed_children": [],
     "html": "<figure class=\"figure\" data-gjs-type=\"figure\" data-ratio=\"4:3\"><img data-prop=\"src\" data-asset-key=\"banner/home\" alt=\"\"><figcaption data-prop=\"caption\">Caption</figcaption></figure>",
     "css": ".figure{margin:2rem 0}.figure img{max-width:100%;height:auto}.figure figcaption{font-size:.875rem;color:var(--muted)}"},

    {"name": "gallery", "kind": "block", "type": "gallery", "label": "Gallery", "category": "Media",
     "renderer": "components/gallery.ts", "version": "1.0.0",
     "bindings": ["asset-src"],
     "props": {"type": "object", "properties": {"columns": {"type": "integer", "minimum": 1, "maximum": 6}}, "additionalProperties": false},
     "editable": [{"prop": "src", "type": "asset"}],
     "allowed_children": ["figure"],
     "html": "<div class=\"gallery\" data-gjs-type=\"gallery\" data-columns=\"3\"><figure class=\"gallery__item\"><img data-prop=\"src\" data-asset-key=\"banner/home\" alt=\"\"></figure></div>",
     "css": ".gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.gallery img{width:100%;height:auto}"},

    {"name": "download-button", "kind": "block", "type": "download-button", "label": "Download button", "category": "Commerce",
     "renderer": "components/download-button.ts", "version": "1.0.0",
     "bindings": ["asset-href", "title"],
     "props": {"type": "object", "properties": {"label": {"type": "string", "maxLength": 80}}, "additionalProperties": false},
     "editable": [{"prop": "href", "type": "asset"}, {"prop": "label", "type": "text"}],
     "allowed_children": [],
     "html": "<p class=\"download\" data-gjs-type=\"download-button\"><a class=\"btn\" data-prop=\"href\" data-asset-key=\"vault/book\" href=\"/d/vault-book\"><span data-prop=\"label\">Download the book</span></a></p>",
     "css": ".download{margin:2rem 0}.download .btn{display:inline-block;padding:.75rem 1.25rem}"},

    {"name": "cta", "kind": "block", "type": "cta", "label": "Call to action", "category": "Structure",
     "renderer": "components/cta.ts", "version": "1.0.0",
     "bindings": ["title", "href-target"],
     "props": {"type": "object", "properties": {}, "additionalProperties": false},
     "editable": [{"prop": "title", "type": "text"}, {"prop": "target", "type": "href"}],
     "allowed_children": [],
     "html": "<aside class=\"cta\" data-gjs-type=\"cta\"><p class=\"cta__title\" data-prop=\"title\">Ready when you are.</p><a class=\"btn\" data-prop=\"target\" href=\"/contact\">Get in touch</a></aside>",
     "css": ".cta{border:1px solid var(--line);padding:2rem;text-align:center}"},

    {"name": "form", "kind": "block", "type": "form", "label": "Form", "category": "Commerce",
     "renderer": "components/form.ts", "version": "1.0.0",
     "bindings": [],
     "props": {"type": "object", "properties": {"form": {"type": "string"}}, "required": ["form"], "additionalProperties": false},
     "editable": [{"prop": "email", "type": "text"}],
     "allowed_children": [],
     "html": "<form class=\"form\" data-gjs-type=\"form\" data-form=\"contact\"><label class=\"form__label\">Email<input class=\"form__input\" name=\"email\" type=\"email\" data-prop=\"email\" placeholder=\"you@example.com\"></label><button class=\"btn\" type=\"submit\">Send</button></form>",
     "css": ".form{max-width:32rem;margin:2rem auto}.form__label{display:block;margin-bottom:.75rem}.form__input{display:block;width:100%;padding:.5rem}"},

    {"name": "embed", "kind": "block", "type": "embed", "label": "Embed", "category": "Media",
     "renderer": "components/embed.ts", "version": "1.0.0",
     "bindings": [],
     "props": {"type": "object", "properties": {"src": {"type": "string", "format": "uri"}}, "required": ["src"], "additionalProperties": false},
     "editable": [{"prop": "src", "type": "href"}],
     "allowed_children": [],
     "html": "<div class=\"embed\" data-gjs-type=\"embed\"><p class=\"embed__label\" data-prop=\"src\">https://example.com/embed</p></div>",
     "css": ".embed{border:1px dashed var(--line);padding:1rem}"},

    {"name": "list", "kind": "list", "type": "list", "label": "List (repeating)", "category": "Data",
     "renderer": "components/list.ts", "version": "1.0.0",
     "repeat_child": "[data-repeat]", "limit_max": 50,
     "bindings": ["title", "subtitle", "href-slug", "asset-cover"],
     "props": {"type": "object", "properties": {"source": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "required": ["source"], "additionalProperties": false},
     "loop": "SSR clones the single [data-repeat] child once per row; text goes through data-bind-<col> (a text node, never markup), href through data-bind-href-<col> (via site.url()), src/srcset through data-bind-asset-<col> (via site.asset()); zero rows render the [data-empty] child; data-limit is clamped to limit_max and data-truncated is set when it clamped.",
     "editable": [],
     "allowed_children": ["prose", "figure", "cta"],
     "html": "<div class=\"list\" data-gjs-type=\"list\" data-source=\"posts\" data-limit=\"3\"><article class=\"card\" data-repeat><h3 class=\"card__title\" data-bind-title=\"title\">Post title</h3><a class=\"card__link\" data-bind-href-slug=\"slug\" href=\"/blog/post\">Read</a></article><p class=\"list__empty\" data-empty>No posts yet.</p></div>",
     "css": ".list{display:grid;gap:1rem}.card{border:1px solid var(--line);padding:1rem}"},

    {"name": "copy-email", "kind": "island", "type": "copy-email", "label": "Copy email", "category": "Interactive",
     "renderer": "islands/copy-email.ts", "version": "1.0.0",
     "bindings": [], "props": {"type": "object", "properties": {"address": {"type": "string", "format": "email"}}, "required": ["address"], "additionalProperties": false},
     "editable": [],
     "allowed_children": [],
     "html": "<button class=\"island island--copy-email\" data-gjs-type=\"copy-email\" data-island=\"copy-email\" data-props=\"{&quot;address&quot;:&quot;hello@example.com&quot;}\" type=\"button\" data-prop=\"address\">Copy email</button>",
     "css": ".island--copy-email{cursor:pointer;padding:.5rem .75rem}"},

    {"name": "page", "kind": "shell", "renderer": "components/shell-page.astro", "version": "1.0.0", "bindings": []},
    {"name": "landing", "kind": "shell", "renderer": "components/shell-landing.astro", "version": "1.0.0", "bindings": []},
    {"name": "post", "kind": "shell", "renderer": "components/shell-post.astro", "version": "1.0.0", "bindings": []},
    {"name": "index", "kind": "shell", "renderer": "components/shell-index.astro", "version": "1.0.0", "bindings": []}
  ]
}

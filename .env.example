# .env.example — every SKW_ name from SDS §4.3 and nothing else.
# Copy to .env, fill the six required secrets, then `docker compose up -d`.
# No secret in this file is real.

# Images: the compose file ships PLACEHOLDER all-zero digests, so a bare
# `docker compose up -d` fails with "error from registry: denied". Build locally
# and override these two, or pull a published release. (docs/DEPLOY.md §1)
SKW_APP_IMAGE=skw-app:local
SKW_ACME_IMAGE=skw-acme:local

# Required (§2.3 step 1)
SKW_EDGE_TOKEN=replace-with-32-bytes-of-hex
SKW_SESSION_KEY=replace-with-32-bytes-of-hex
SKW_DOWNLOAD_TOKEN_KEY=replace-with-32-bytes-of-hex
SKW_IP_HASH_KEY=replace-with-32-bytes-of-hex
# D37: admin is a path (/admin) on each tenant host, not an origin. This value now
# only derives the demos vhost host (demos.<domain>) and satisfies compose/install.sh.
SKW_ADMIN_ORIGIN=https://admin.example.com
SKW_BUILD_ID=dev

# Optional, with the frozen defaults (§4.3)
SKW_DATA_DIR=/srv/data
SKW_DB_POOL_MAX=64
SKW_DB_BUSY_TIMEOUT_MS=5000
SKW_EDGE_TRUSTED_CIDRS=127.0.0.1/32,172.16.0.0/12
SKW_ARGON2_MAX_CONCURRENT=4
SKW_DDL_MAX_STATEMENTS=8
SKW_RENDER_MODE=live
SKW_SCHEMA_EDIT=off
SKW_FLEET_MODE=1
SKW_SNAPSHOT_MAX_COMBOS=1024
SKW_SNAPSHOT_MAX_BYTES=2097152
SKW_REPOINT_MAX_ROWS=5000
SKW_BOX_RPS=192
SKW_EMAIL_MODE=off
# §9.1a (E-17): comma-separated CIDRs allowed to reach /admin. Empty in
# every exported bundle — and empty means TOTP is mandatory and idle drops to 15 min.
# Enforced by nginx inside each tenant block's /admin location (D37); the app reads
# it, and never enforces it.
SKW_ADMIN_ALLOWLIST=

# Required by §2.3 step 2 (not an SKW_ name, but a boot assertion)
UV_THREADPOOL_SIZE=8

# acme-companion registration address (the acme service, not the app)
ACME_EMAIL=ops@example.com

---
export const prerender = false;
import PageShell from '../components/shells/page.astro';

import type { NavTree } from '../nav.ts';
import type { SiteChrome } from '../chrome.ts';

interface Locals {
  tenantKey: string;
  path: string;
  page: { title: string; bodyHtml: string; bodyCss: string; path: string };
  /** §13.3.4 `page.head`: passed through from the app, never assembled here. */
  head?: string;
  /** `cms_nav`, already loaded, resolved and ordered by the app (`app/render/nav.ts`). */
  nav: NavTree;
  /** S8l: `null` when the tenant has no site chrome; see `app/render/chrome.ts`. */
  chrome: (SiteChrome & { logoUrl: string | null; sheetVersion?: string; previewTheme?: string }) | null;
  /** S8s: the page's own stylesheet URL, or `null`. See `app/render/components/shells/page.astro`. */
  cssHref?: string | null;
}
const { tenantKey, page, head, nav, chrome, cssHref } = Astro.locals as unknown as Locals;
---
<PageShell page={page} tenantKey={tenantKey} head={head} nav={nav} chrome={chrome} cssHref={cssHref ?? null} />

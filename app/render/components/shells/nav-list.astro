---
/**
 * One menu level — a `<ul>` of `cms_nav` rows, recursing into a child level.
 *
 * The items arrive already ordered and already validated by `app/render/nav.ts`
 * (the app owns the database, §2.2); this component owns the markup and nothing
 * else. Astro escapes `{item.label}` and `href={item.href}`, so a label with `<`
 * in it is text and a resolved href is an attribute value — the reason the href
 * is resolved in TypeScript and not assembled here.
 *
 * The template is deliberately one line per element: Astro preserves the
 * whitespace between tags, and a menu that changes its bytes because someone
 * re-indented the component would break the export's byte-identity gate for no
 * reason a reader could see.
 */
import NavList from './nav-list.astro';

interface Item {
  label: string;
  href: string;
  children: Item[];
}
interface Props {
  items: Item[];
  /**
   * The path being drawn. The item whose href equals it gets `aria-current="page"`, which is how a
   * menu says "you are here" — in the markup, so any theme can style it and a screen reader can
   * announce it, instead of a stylesheet that has to enumerate every page a site will ever have.
   */
  current?: string;
  /**
   * The `<ul>`'s class. The chrome's own stylesheet (`chromecCss` in `app/render/chrome.ts`) and
   * every site theme select the menu by `.site-menu`, and until S8o this component emitted a bare
   * `<ul>` — so those rules matched nothing and the header's menu was unstyled on every site. The
   * prop is optional so the export path (which passes no nav at all) keeps its bytes.
   */
  className?: string;
}
const { items, className, current } = Astro.props as Props;
---

<ul class={className}>{items.map((item) => (<li><a href={item.href} aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>{item.children.length > 0 ? <NavList items={item.children} className={className} current={current} /> : null}</li>))}</ul>

---
/**
 * The default shell (§3: app/render/components/shells/page.astro).
 *
 * It receives an already-loaded cms_page record from the app: the Astro layer
 * never opens a database (§2.2 — render-read handles belong to the app, and the
 * bundle has no SQLite). The same is true of `nav`: `loadNav()` in
 * `app/render/nav.ts` reads `cms_nav`, resolves every href and refuses a row it
 * cannot resolve; this component only writes the markup.
 *
 * ## Site chrome (S8l)
 *
 * `chrome` is the identity bar and the footer, from `cms_settings` (`app/render/chrome.ts`):
 * the site's name, an optional logo, whether the header or the footer pins to the viewport,
 * and one footer sentence. The app passes `null` when a tenant has set none of it, and the
 * document is then **byte-for-byte** what this shell emitted before the feature existed —
 * which is what keeps the exported static tree (`app/export/document.ts`, which never
 * receives chrome) identical for a site that has not opened the Site screen.
 *
 * The chrome expressions sit on the same line as `<body …>` and as `<main …>` for that
 * reason: an expression that renders `null` contributes no whitespace, so adding this
 * feature cannot move a single byte of an untouched site.
 */
import NavList from './nav-list.astro';
import type { SiteChrome } from '../../chrome.ts';

interface PageLike {
  title: string;
  bodyHtml: string;
  bodyCss: string;
  path: string;
}
interface NavItem {
  label: string;
  href: string;
  children: NavItem[];
}
interface Props {
  page: PageLike;
  tenantKey: string;
  /**
   * §13.3.4's `page.head` filter: the markup a plugin may add to `<head>`, already
   * length-checked (≤ 4 KiB) and already known to be a string. It is **only** markup —
   * the filter has no parameter for the body, the status or a header, and the shell
   * interpolates it inside `<head>` and nowhere else.
   */
  head?: string;
  /**
   * The header and footer menus, from `cms_nav`. Empty on a site with no rows, and the
   * shell then writes no `<header>`/`<footer>` at all — the exported static shell
   * (`app/export/astro.ts`) carries no nav, and a page that emitted an empty `<nav>`
   * would stop being byte-identical to it.
   */
  nav?: { header: NavItem[]; footer: NavItem[] };
  /** `null` when the tenant has no chrome; see the note above about bytes. */
  chrome?: (SiteChrome & { logoUrl: string | null }) | null;
}
const { page, tenantKey, head, nav, chrome } = Astro.props as Props;
const header = nav !== undefined && nav.header.length > 0 ? nav.header : null;
const footer = nav !== undefined && nav.footer.length > 0 ? nav.footer : null;
const bar = chrome === undefined || chrome === null ? null : chrome;
const identity = bar !== null && (bar.title !== '' || bar.logoUrl !== null);
// A bar with nothing in it is not a bar: a `<header>` with no identity and no menu would
// be an empty box with a border. `hasChrome` already refuses to pass such a record, and
// these guards keep the template honest if it ever does.
const headerBar = bar !== null && (identity || header !== null) ? bar : null;
const footerBar = bar !== null && (footer !== null || bar.footerText !== '') ? bar : null;
// S8o: the stylesheet is a **response**, linked, not an inline `<style>`.
//
// The site's CSP is `style-src 'self'` with no inline allowance, so a browser blocked every
// inline `<style>` this shell used to write — which meant the chrome's own layout rules and a
// page's `body_css` never applied in a real browser, while curl and the tests saw them in the
// markup. `/theme.css` serves the same bytes from this origin (chrome, then theme, then the
// page's own CSS), which the policy allows unchanged.
//
// `null` when there is nothing to serve, so a tenant with no chrome and no theme and a page with
// no CSS renders byte-for-byte what it rendered before this existed — which is what keeps the
// exported static tree identical.
const showStyle = headerBar !== null || footerBar !== null;
const theme = bar === null ? '' : bar.themeCss;
// The **site's** stylesheet — the chrome's rules and the theme — is one file per site, linked.
// A single page's own `body_css` stays inline: the export target (`app/export/document.ts`)
// writes it inline too, and the two trees are compared byte-for-byte (`test/export-targets`).
// That means a page's own CSS is still subject to `style-src 'self'`; moving it out needs a
// per-page URL in the export as well, and that is a separate piece of work, stated in the errata.
const sheetHref = showStyle || theme !== '' ? '/theme.css' : null;
const headerClass = headerBar === null ? '' : headerBar.headerSticky ? 'site-header site-header--sticky' : 'site-header';
const footerClass = footerBar === null ? '' : footerBar.footerSticky ? 'site-footer site-footer--sticky' : 'site-footer';
---
<!doctype html>
<html lang="en" data-tenant={tenantKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>{head ? <Fragment set:html={head} /> : null}{sheetHref !== null ? <link rel="stylesheet" href={sheetHref} /> : null}
    {page.bodyCss ? <style set:html={page.bodyCss} /> : null}
  </head>
  <body data-page-path={page.path}>{headerBar !== null ? <header class={headerClass}>{identity ? <a class="site-id" href="/">{headerBar.logoUrl !== null ? <img src={headerBar.logoUrl} alt="" /> : null}<span>{headerBar.title}</span></a> : null}{header !== null ? <nav aria-label="Main"><NavList items={header} className="site-menu" /></nav> : null}</header> : header !== null ? <header><nav aria-label="Main"><NavList items={header} className="site-menu" /></nav></header> : null}
    <main set:html={page.bodyHtml} />{footerBar !== null ? <footer class={footerClass}>{footer !== null ? <nav aria-label="Footer"><NavList items={footer} className="site-menu site-menu--footer" /></nav> : null}{footerBar.footerText !== '' ? <p class="site-footer__text">{footerBar.footerText}</p> : null}</footer> : footer !== null ? <footer><nav aria-label="Footer"><NavList items={footer} /></nav></footer> : null}
  </body>
</html>

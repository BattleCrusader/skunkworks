---
/**
 * The default shell (§3: app/render/components/shells/page.astro).
 *
 * It receives an already-loaded cms_page record from the app: the Astro layer
 * never opens a database (§2.2 — render-read handles belong to the app, and the
 * bundle has no SQLite). The same is true of `nav`: `loadNav()` in
 * `app/render/nav.ts` reads `cms_nav`, resolves every href and refuses a row it
 * cannot resolve; this component only writes the markup.
 */
import NavList from './nav-list.astro';

interface PageLike {
  title: string;
  bodyHtml: string;
  bodyCss: string;
  path: string;
}
interface NavItem {
  label: string;
  href: string;
  children: NavItem[];
}
interface Props {
  page: PageLike;
  tenantKey: string;
  /**
   * §13.3.4's `page.head` filter: the markup a plugin may add to `<head>`, already
   * length-checked (≤ 4 KiB) and already known to be a string. It is **only** markup —
   * the filter has no parameter for the body, the status or a header, and the shell
   * interpolates it inside `<head>` and nowhere else.
   */
  head?: string;
  /**
   * The header and footer menus, from `cms_nav`. Empty on a site with no rows, and the
   * shell then writes no `<header>`/`<footer>` at all — the exported static shell
   * (`app/export/astro.ts`) carries no nav, and a page that emitted an empty `<nav>`
   * would stop being byte-identical to it.
   */
  nav?: { header: NavItem[]; footer: NavItem[] };
}
const { page, tenantKey, head, nav } = Astro.props as Props;
const header = nav !== undefined && nav.header.length > 0 ? nav.header : null;
const footer = nav !== undefined && nav.footer.length > 0 ? nav.footer : null;
---
<!doctype html>
<html lang="en" data-tenant={tenantKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>{head ? <Fragment set:html={head} /> : null}
    {page.bodyCss ? <style set:html={page.bodyCss} /> : null}
  </head>
  <body data-page-path={page.path}>{header !== null ? <header><nav aria-label="Main"><NavList items={header} /></nav></header> : null}
    <main set:html={page.bodyHtml} />{footer !== null ? <footer><nav aria-label="Footer"><NavList items={footer} /></nav></footer> : null}
  </body>
</html>

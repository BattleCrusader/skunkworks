@startuml
/' Generated by scripts/model/gen_schema.py — do not edit by hand.
   Every table and column here is emitted from the same spec as schema/control.sql
   and schema/site.sql. ER<->DDL parity is therefore mechanical, not editorial. '/
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #444444
  ArrowColor #444444
}

package "control.db  (global, never exported)" {
  entity tenant as "tenant" <<control>> {
    id : INTEGER <<PK>>
    key : TEXT <<UQ>>
    mode : TEXT
    status : TEXT
    display_name : TEXT
    db_version : INTEGER
    storage_quota_bytes : INTEGER
    request_budget_per_min : INTEGER
    demo_expires_at : TEXT
    created_at : TEXT
    archived_at : TEXT
  }
  entity domain as "domain" <<control>> {
    id : INTEGER <<PK>>
    host : TEXT <<UQ>>
    tenant_id : INTEGER <<FK>>
    kind : TEXT
    is_primary : INTEGER
    cert_state : TEXT
    created_at : TEXT
  }
  entity user_account as "user_account" <<control>> {
    id : INTEGER <<PK>>
    tenant_id : INTEGER <<FK>>
    email : TEXT
    password_hash : TEXT
    role : TEXT
    totp_secret : TEXT
    reset_token_hash : TEXT
    reset_expires_at : TEXT
    failed_logins : INTEGER
    locked_until : TEXT
    created_at : TEXT
    last_login_at : TEXT
  }
  entity session as "session" <<control>> {
    id : TEXT <<PK>>
    user_id : INTEGER <<FK>>
    tenant_id : INTEGER <<FK>>
    csrf_secret : TEXT
    ip_hash : TEXT
    ua_hash : TEXT
    created_at : TEXT
    expires_at : TEXT
    rotated_from : TEXT
    revoked_at : TEXT
  }
  entity audit_log as "audit_log" <<control>> {
    id : INTEGER <<PK>>
    tenant_id : INTEGER
    actor_user_id : INTEGER
    actor_label : TEXT
    action : TEXT
    target_kind : TEXT
    target_id : TEXT
    before_json : TEXT
    after_json : TEXT
    ip_hash : TEXT
    ts : TEXT
  }
  entity deploy_token as "deploy_token" <<control>> {
    id : INTEGER <<PK>>
    tenant_id : INTEGER <<FK>>
    token_hash : TEXT <<UQ>>
    label : TEXT
    expires_at : TEXT
    revoked_at : TEXT
    last_used_at : TEXT
    created_at : TEXT
  }
  entity control_migration as "control_migration" <<control>> {
    id : INTEGER <<PK>>
    tag : TEXT <<UQ>>
    checksum : TEXT
    applied_at : TEXT
  }
}

package "tenants/<key>/site.db  (one file per tenant)" {
  entity cms_settings as "cms_settings" <<site>> {
    key : TEXT <<PK>>
    value_json : TEXT
    type : TEXT
    updated_at : TEXT
    updated_by : INTEGER
  }
  entity cms_page as "cms_page" <<site>> {
    id : INTEGER <<PK>>
    path : TEXT <<UQ>>
    slug : TEXT
    title : TEXT
    status : TEXT
    template : TEXT
    body_html : TEXT
    css : TEXT
    seo_json : TEXT
    etag : TEXT
    published_at : TEXT
    created_at : TEXT
    updated_at : TEXT
    updated_by : INTEGER
  }
  entity cms_page_revision as "cms_page_revision" <<site>> {
    id : INTEGER <<PK>>
    page_id : INTEGER <<FK>>
    body_html : TEXT
    css : TEXT
    note : TEXT
    created_at : TEXT
    created_by : INTEGER
  }
  entity cms_nav as "cms_nav" <<site>> {
    id : INTEGER <<PK>>
    location : TEXT
    parent_id : INTEGER <<FK>>
    label : TEXT
    href_kind : TEXT
    href_target : TEXT
    position : INTEGER
    visible : INTEGER
  }
  entity cms_asset as "cms_asset" <<site>> {
    id : INTEGER <<PK>>
    key : TEXT <<UQ>>
    filename : TEXT
    mime : TEXT
    bytes : INTEGER
    sha256 : TEXT
    kind : TEXT
    access_class : TEXT
    storage_path : TEXT
    width : INTEGER
    height : INTEGER
    alt_text : TEXT
    caption : TEXT
    watermark_asset_id : INTEGER <<FK>>
    watermark_spec_json : TEXT
    frozen_at : TEXT
    created_at : TEXT
    created_by : INTEGER
  }
  entity cms_asset_alias as "cms_asset_alias" <<site>> {
    key : TEXT <<PK>>
    asset_id : INTEGER <<FK>>
    created_at : TEXT
  }
  entity cms_asset_variant as "cms_asset_variant" <<site>> {
    id : INTEGER <<PK>>
    asset_id : INTEGER <<FK>>
    label : TEXT
    format : TEXT
    width : INTEGER
    height : INTEGER
    bytes : INTEGER
    sha256 : TEXT
    storage_path : TEXT
  }
  entity cms_asset_link as "cms_asset_link" <<site>> {
    id : INTEGER <<PK>>
    asset_id : INTEGER <<FK>>
    owner_kind : TEXT
    owner_id : INTEGER
    created_at : TEXT
  }
  entity cms_asset_bundle as "cms_asset_bundle" <<site>> {
    id : INTEGER <<PK>>
    key : TEXT <<UQ>>
    title : TEXT
    note : TEXT
    created_at : TEXT
  }
  entity cms_asset_bundle_item as "cms_asset_bundle_item" <<site>> {
    bundle_id : INTEGER <<FK>>
    asset_id : INTEGER <<FK>>
    position : INTEGER
  }
  entity cms_download_code as "cms_download_code" <<site>> {
    id : INTEGER <<PK>>
    code_lookup : TEXT <<UQ>>
    code_hash : TEXT
    asset_id : INTEGER <<FK>>
    bundle_id : INTEGER <<FK>>
    max_uses : INTEGER
    uses : INTEGER
    expires_at : TEXT
    issued_to_email : TEXT
    order_ref : TEXT
    revoked_at : TEXT
    created_at : TEXT
    last_used_at : TEXT
  }
  entity cms_download_event as "cms_download_event" <<site>> {
    id : INTEGER <<PK>>
    code_id : INTEGER <<FK>>
    asset_id : INTEGER <<FK>>
    ip_hash : TEXT
    ua_hash : TEXT
    bytes_sent : INTEGER
    ranged : INTEGER
    outcome : TEXT
    ts : TEXT
  }
  entity cms_watermark_render as "cms_watermark_render" <<site>> {
    id : INTEGER <<PK>>
    asset_id : INTEGER <<FK>>
    spec_sha : TEXT
    source_sha : TEXT
    bytes : INTEGER
    path : TEXT
    created_at : TEXT
  }
  entity cms_form as "cms_form" <<site>> {
    id : INTEGER <<PK>>
    key : TEXT <<UQ>>
    title : TEXT
    fields_json : TEXT
    mode : TEXT
    action_url : TEXT
    notify_email : TEXT
    created_at : TEXT
  }
  entity cms_form_submission as "cms_form_submission" <<site>> {
    id : INTEGER <<PK>>
    form_id : INTEGER <<FK>>
    payload_json : TEXT
    ip_hash : TEXT
    spam_score : REAL
    state : TEXT
    ts : TEXT
  }
  entity cms_datasource as "cms_datasource" <<site>> {
    id : INTEGER <<PK>>
    key : TEXT <<UQ>>
    kind : TEXT
    spec_json : TEXT
    is_public : INTEGER
    ttl_s : INTEGER
    created_at : TEXT
    published_at : TEXT
    published_by : INTEGER
  }
  entity cms_view_registry as "cms_view_registry" <<site>> {
    name : TEXT <<PK>>
    checksum : TEXT
    created_at : TEXT
  }
  entity cms_table_registry as "cms_table_registry" <<site>> {
    id : INTEGER <<PK>>
    table_name : TEXT <<UQ>>
    ddl_version : INTEGER
    column_count : INTEGER
    created_at : TEXT
    created_by : INTEGER
    notes : TEXT
  }
  entity cms_audit as "cms_audit" <<site>> {
    id : INTEGER <<PK>>
    actor_user_id : INTEGER
    actor_label : TEXT
    action : TEXT
    target_kind : TEXT
    target_id : TEXT
    before_json : TEXT
    after_json : TEXT
    ts : TEXT
  }
  entity cms_redirect as "cms_redirect" <<site>> {
    id : INTEGER <<PK>>
    from_path : TEXT <<UQ>>
    to_path : TEXT
    status : INTEGER
    created_at : TEXT
    hits : INTEGER
  }
}

cms_asset ||--o{ cms_asset : "watermark_asset_id"
cms_asset ||--o{ cms_asset_alias : "asset_id"
cms_asset ||--o{ cms_asset_bundle_item : "asset_id"
cms_asset ||--o{ cms_asset_link : "asset_id"
cms_asset ||--o{ cms_asset_variant : "asset_id"
cms_asset ||--o{ cms_download_code : "asset_id"
cms_asset ||--o{ cms_download_event : "asset_id"
cms_asset ||--o{ cms_watermark_render : "asset_id"
cms_asset_bundle ||--o{ cms_asset_bundle_item : "bundle_id"
cms_asset_bundle ||--o{ cms_download_code : "bundle_id"
cms_download_code ||--o{ cms_download_event : "code_id"
cms_form ||--o{ cms_form_submission : "form_id"
cms_nav ||--o{ cms_nav : "parent_id"
cms_page ||--o{ cms_page_revision : "page_id"
tenant ||--o{ deploy_token : "tenant_id"
tenant ||--o{ domain : "tenant_id"
tenant ||--o{ session : "tenant_id"
tenant ||--o{ user_account : "tenant_id"
tenant ||..o{ cms_audit : "rows carry tenant via file, not FK"
user_account ||--o{ session : "user_id"

note bottom of tenant
  FK arrows are real SQLite foreign keys.
  The dotted line is topology, not a constraint:
  control.tenant and site.cms_* never share a connection.
end note
@enduml

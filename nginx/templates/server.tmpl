# nginx/templates/server.tmpl — the generator's template (§3). tools/nginx_gen.ts
# emits this shape once per tenant; install.sh renders the placeholder block.
#
# `listen 80` is always present (§12.5: a host serves on 80 while its certificate
# is pending) and `listen 443 ssl` is emitted only for a host whose
# `domain.cert_state = 'issued'` — a block that listens on 443 without a
# certificate fails `nginx -t` (E-5).
server {
    listen 80;{{TLS_LISTEN}}
    server_name {{SERVER_NAMES}};

    location / {
        limit_req zone=tenant burst={{BURST}} nodelay;
        include /etc/nginx/snippets/skunk-proxy.conf;
        proxy_pass http://app:3000;
    }

    location /media/ {
        alias /srv/content/public/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /__protected/ {
        internal;
        alias /srv/content/media/;
        limit_rate 1m;
    }
}

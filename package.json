{
  "name": "skunkworks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && astro build",
    "migrate": "node dist/app/db/migrate.js --tenant all",
    "start": "node dist/app/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --test-concurrency=1 $(find test -name '*.test.ts' -not -path 'test/perf/*' | sort)",
    "test:perf": "node --test --test-concurrency=1 test/perf/login-timing.perf.test.ts test/perf/sources-cost.perf.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fastify/multipart": "^9.4.0",
    "@node-rs/argon2": "^2.2.2",
    "astro": "^7.4.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "grapesjs": "^0.23.8",
    "nodemailer": "10.2.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2"
  }
}

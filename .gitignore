# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.astro/
.output/
# root-anchored: docs/build/ holds the slice reports and must stay tracked
/build/
/.e2e-*/

# Secrets and per-host state
.env
.env.*
!.env.example

# Tenant runtime data — customer databases, uploads, rendered bundles
data/
content/media/
content/public/
content/protected/

# Local scratch
.DS_Store
*.log
__pycache__/

# theme packages are build output; the sources in themes/<name>/ are what is tracked
themes/*.zip
scratch/

# Websites live in their own repository. Commercial and client sites are not part of the
# platform: skunkworks-sites/ is a checkout of github.com/BattleCrusader/skunkworks-sites,
# with one directory per site (sources, theme, verifier, deploy kit, tenant data).
skunkworks-sites/